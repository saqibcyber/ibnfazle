---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CategoryListing from '../../components/CategoryListing.astro';
import { getAllContent, getCategories, getCategoryPages, getSiteSettings } from '../../lib/sanity';

export async function getStaticPaths() {
  const [items, categories, categoryPages, settings] = await Promise.all([
    getAllContent(),
    getCategories(),
    getCategoryPages(),
    getSiteSettings(),
  ]);

  return categoryPages
    .filter((c) => c.slug !== 'library' && c.slug !== 'page')
    .map((category) => ({
      params: { category: category.slug },
      props: {
        category,
        items: items.filter((i) => i.category?.slug === category.slug),
        categories,
        settings,
      },
    }));
}

const { category, items, categories, settings } = Astro.props;
const heading = category.heading || category.title;
const title = `${heading} | Thaqib ibn Fazle`;
const description =
  category.subheading || `Content in ${category.title} from Thaqib ibn Fazle.`;
---

<BaseLayout title={title} description={description}>
  <SiteHeader tagline={settings.tagline} socialLinks={settings.socialLinks} />
  <main class="topic-cluster">
    <CategoryListing
      category={category}
      items={items}
      categories={categories}
      page={1}
    />
  </main>
  <SiteFooter settings={settings} categories={categories} />
</BaseLayout>
