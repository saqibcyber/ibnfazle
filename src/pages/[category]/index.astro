---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContentListItem from '../../components/ContentListItem.astro';
import { getAllContent, getCategories, getCategoryPages, getSiteSettings } from '../../lib/sanity';

export async function getStaticPaths() {
  const [items, categories, categoryPages, settings] = await Promise.all([
    getAllContent(),
    getCategories(),
    getCategoryPages(),
    getSiteSettings(),
  ]);

  return categoryPages
    .filter((c) => c.slug !== 'library')
    .map((category) => ({
      params: { category: category.slug },
      props: {
        category,
        items: items.filter((i) => i.category?.slug === category.slug),
        categories,
        settings,
      },
    }));
}

const { category, items, categories, settings } = Astro.props;
const heading = category.heading || category.title;
const title = `${heading} | Thaqib ibn Fazle`;
const description =
  category.subheading || `Content in ${category.title} from Thaqib ibn Fazle.`;

const sectionIds = new Set(
  category.sections.flatMap((section) => section.items.map((item) => item._id)),
);
const unsectioned = items.filter((item) => !sectionIds.has(item._id));
const hasSections = category.sections.some((s) => s.items.length > 0);
---

<BaseLayout title={title} description={description}>
  <SiteHeader tagline={settings.tagline} socialLinks={settings.socialLinks} />
  <main class="topic-cluster">
    <header class="topic-cluster__header">
      <h2 class="topic-cluster__heading">{heading}</h2>
      {category.subheading && <p class="topic-cluster__subheading">{category.subheading}</p>}
    </header>

    {
      categories.length > 0 && (
        <nav class="filter-row" aria-label="Categories">
          <a class="filter-chip" href="/">All</a>
          {categories.map((cat) => (
            <a
              class:list={['filter-chip', { 'is-active': cat.slug === category.slug }]}
              href={`/${cat.slug}`}
            >
              {cat.title}
            </a>
          ))}
        </nav>
      )
    }

    {
      hasSections ? (
        category.sections
          .filter((section) => section.items.length > 0)
          .map((section) => (
            <section class="cluster-section" aria-labelledby={`section-${section._key}`}>
              <div class="section-label">
                <h3 class="section-label__title" id={`section-${section._key}`}>
                  {section.heading}
                </h3>
                <span class="section-label__meta">
                  {section.items.length} {section.items.length === 1 ? 'item' : 'items'}
                </span>
              </div>
              <ul class="content-list">
                {section.items.map((item) => (
                  <li>
                    <ContentListItem item={item} />
                  </li>
                ))}
              </ul>
            </section>
          ))
      ) : null
    }

    {
      (!hasSections || unsectioned.length > 0) && (
        <section class="cluster-section" aria-labelledby="category-library-heading">
          <div class="section-label">
            <h3 class="section-label__title" id="category-library-heading">
              {hasSections ? 'More in this category' : 'Library'}
            </h3>
            <span class="section-label__meta">
              {(hasSections ? unsectioned : items).length}{' '}
              {(hasSections ? unsectioned : items).length === 1 ? 'item' : 'items'}
            </span>
          </div>
          {
            (hasSections ? unsectioned : items).length > 0 ? (
              <ul class="content-list">
                {(hasSections ? unsectioned : items).map((item) => (
                  <li>
                    <ContentListItem item={item} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="library-empty">No content in this category yet.</p>
            )
          }
        </section>
      )
    }
  </main>
  <SiteFooter settings={settings} categories={categories} />
</BaseLayout>
