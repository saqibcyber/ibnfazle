---
import type { ContentItem } from '../lib/sanity';

interface Props {
  item: ContentItem;
  label?: string;
}

const { item, label = 'Latest' } = Astro.props;
---

<a class="hero-feature" href={item.href}>
  <div class="hero-feature__media">
    {
      item.imageUrl ? (
        <img
          src={item.imageUrl}
          alt=""
          width="1200"
          height="675"
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="hero-feature__placeholder" aria-hidden="true"></div>
      )
    }
  </div>
  <div class="hero-feature__body">
    <p class="hero-feature__label">{label}</p>
    {
      item.category && (
        <p class="hero-feature__category">{item.category.title}</p>
      )
    }
    <h2 class="hero-feature__title">{item.title}</h2>
    <p class="hero-feature__summary">{item.summary}</p>
    <p class="hero-feature__meta">
      <span>{item.author}</span>
      {item.readTime && <span>· {item.readTime} min</span>}
      {item.pageCount && <span>· {item.pageCount} pages</span>}
    </p>
  </div>
</a>
