---
import type { ContentItem } from '../lib/sanity';

interface Props {
  item: ContentItem;
}

const { item } = Astro.props;

const metaParts: string[] = [];
if (item.category?.title) metaParts.push(item.category.title);
if (item.type === 'article' && item.readTime) metaParts.push(`${item.readTime} min`);
if (item.type === 'pdf' && item.pageCount) metaParts.push(`${item.pageCount} pages`);

const searchCategory = [item.category?.title, item.category?.slug].filter(Boolean).join(' ');
const searchTags = (item.tags || []).map((t) => `${t.title} ${t.slug}`).join(' ');
---

<a
  class="content-row"
  href={item.href}
  data-id={item._id}
  data-type={item.type}
  data-category={item.category?.slug || ''}
  data-title={item.title}
  data-summary={item.summary}
  data-category-label={searchCategory}
  data-tags={searchTags}
>
  <div class="content-row__media">
    {
      item.imageUrl ? (
        <img
          src={item.imageUrl}
          alt=""
          width="320"
          height="180"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="content-row__placeholder" aria-hidden="true"></div>
      )
    }
  </div>
  <div class="content-row__body">
    {
      metaParts.length > 0 && (
        <p class="content-row__meta">
          <span>{metaParts.join(' · ')}</span>
        </p>
      )
    }
    <h3 class="content-row__title">{item.title}</h3>
    <p class="content-row__summary">{item.summary}</p>
    <p class="content-row__author">{item.author}</p>
  </div>
</a>
