---
import logo from '../assets/logo.svg';
import SocialLinks from './SocialLinks.astro';
import type { SiteSettings, Taxonomy } from '../lib/sanity';

interface Props {
  settings: SiteSettings;
  categories: Taxonomy[];
}

const { settings, categories } = Astro.props;
const { tagline, socialLinks } = settings;
---

<footer class="site-footer">
  <div class="site-footer__grid">
    <div class="site-footer__brand-col">
      <a class="site-footer__logo" href="/" aria-label="Home">
        <img src={logo.src} alt="" width="65" height="65" />
      </a>
      <p class="site-footer__tagline">{tagline}</p>
      <SocialLinks links={socialLinks} class="site-footer__socials" />
    </div>

    {
      categories.length > 0 && (
        <div class="site-footer__links-col">
          <h2 class="site-footer__heading">Quick Links</h2>
          <nav class="site-footer__nav" aria-label="Quick links">
            {categories.map((cat) => (
              <a class="site-footer__nav-link" href={`/${cat.slug}`}>
                {cat.title}
              </a>
            ))}
          </nav>
        </div>
      )
    }
  </div>
</footer>
