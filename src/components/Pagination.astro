---
interface Props {
  page: number;
  totalPages: number;
  hrefForPage: (page: number) => string;
}

const { page, totalPages, hrefForPage } = Astro.props;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {page > 1 ? (
        <a class="pagination__link" href={hrefForPage(page - 1)} rel="prev">
          Previous
        </a>
      ) : (
        <span class="pagination__link is-disabled" aria-disabled="true">Previous</span>
      )}

      <ol class="pagination__pages">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
          <li>
            {n === page ? (
              <span class="pagination__page is-current" aria-current="page">
                {n}
              </span>
            ) : (
              <a class="pagination__page" href={hrefForPage(n)}>
                {n}
              </a>
            )}
          </li>
        ))}
      </ol>

      {page < totalPages ? (
        <a class="pagination__link" href={hrefForPage(page + 1)} rel="next">
          Next
        </a>
      ) : (
        <span class="pagination__link is-disabled" aria-disabled="true">Next</span>
      )}
    </nav>
  )
}
