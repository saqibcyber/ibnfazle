---
import ContentListItem from './ContentListItem.astro';
import type { ContentItem, Taxonomy } from '../lib/sanity';

interface Props {
  items: ContentItem[];
  categories: Taxonomy[];
  heading?: string;
  activeCategory?: string;
}

const {
  items,
  categories,
  heading = 'Library',
  activeCategory = '',
} = Astro.props;
---

<section class="library-browser" data-library-browser>
  <div class="library-search" role="search">
    <span class="library-search__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </span>
    <label class="sr-only" for="library-search-input">Search library</label>
    <input
      id="library-search-input"
      class="library-search__input"
      type="search"
      placeholder="Search…"
      autocomplete="off"
      data-library-search
    />
    <button type="button" class="library-search__button" data-library-search-btn>Search</button>
  </div>

  {
    categories.length > 0 && (
      <nav class="filter-row" aria-label="Categories">
        <a
          class:list={['filter-chip', { 'is-active': !activeCategory }]}
          href="/"
        >
          All
        </a>
        {categories.map((cat) => (
          <a
            class:list={['filter-chip', { 'is-active': activeCategory === cat.slug }]}
            href={`/${cat.slug}`}
          >
            {cat.title}
          </a>
        ))}
      </nav>
    )
  }

  <div class="section-label">
    <h2 class="section-label__title">{heading}</h2>
    <span class="section-label__meta" data-library-count>
      {items.length} {items.length === 1 ? 'item' : 'items'}
    </span>
  </div>

  <ul class="content-list" data-library-list>
    {
      items.map((item) => (
        <li data-library-item>
          <ContentListItem item={item} />
        </li>
      ))
    }
  </ul>

  <p class="library-empty" data-library-empty hidden>No matching content.</p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-library-browser]');
  if (root) {
    const searchInput = root.querySelector<HTMLInputElement>('[data-library-search]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-library-item]'));
    const empty = root.querySelector<HTMLElement>('[data-library-empty]');
    const countEl = root.querySelector<HTMLElement>('[data-library-count]');

    function apply() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      let visible = 0;

      for (const li of items) {
        const row = li.querySelector<HTMLElement>('.content-row');
        if (!row) continue;
        const haystack = [
          row.dataset.title || '',
          row.dataset.summary || '',
          row.dataset.categoryLabel || '',
          row.dataset.tags || '',
        ]
          .join(' ')
          .toLowerCase();
        const show = !q || haystack.includes(q);
        li.hidden = !show;
        if (show) visible += 1;
      }

      if (countEl) {
        countEl.textContent = `${visible} ${visible === 1 ? 'item' : 'items'}`;
      }
      if (empty) empty.hidden = visible > 0;
    }

    searchInput?.addEventListener('input', apply);
    root.querySelector('[data-library-search-btn]')?.addEventListener('click', (e) => {
      e.preventDefault();
      apply();
    });
  }
</script>
